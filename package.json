{
  "name": "shoply",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/publish_frontend.mjs",
    "test": "vitest run",
    "test:store": "vitest run frontend/tests/store.test.ts frontend/tests/cart.test.ts",
    "test:admin": "vitest run frontend/tests/admin.test.ts",
    "test:theme": "vitest run frontend/tests/theme.test.ts",
    "lint": "eslint frontend vite.config.ts --max-warnings=0",
    "format": "prettier --write frontend vite.config.ts tsconfig.json eslint.config.js .prettierrc.json",
    "format:check": "prettier --check frontend vite.config.ts tsconfig.json eslint.config.js .prettierrc.json"
  },
  "dependencies": {
    "pinia": "^4.1.0",
    "vue": "^3.5.0",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.0.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.0.0"
  }
}
