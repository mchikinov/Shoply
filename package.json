{
  "name": "shoply",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/publish_frontend.mjs",
    "test": "vitest run",
    "test:store": "vitest run frontend/tests/store.test.ts",
    "test:admin": "vitest run frontend/tests/admin.test.ts",
    "test:theme": "vitest run frontend/tests/theme.test.ts"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.0.0"
  }
}
